# Global Vale config. Vale finds this wherever you run it, unless a repo ships
# its own .vale.ini—a repo-local file wins, which is what you want for a
# project with house rules of its own.
#
# This file is generated from .vale.ini.in in the vale-styles repo: `make
# config` fills in the home and repo paths and writes the result to
# ~/Library/Application Support/vale/.vale.ini. Edit the template, not the
# generated file.
#
# The rule set follows the writing guidance in ~/CLAUDE.md: Orwell's six rules
# and ASD-STE100 Simplified Technical English. write-good and proselint carry
# most of that—passive voice, weasel words, wordiness, clichés, and the
# tired figures of speech Orwell's first rule is about.
#
# NOTE ON LAYOUT: this is an INI file, so every setting belongs to the section
# heading above it. Keep each rule inside its own [glob] block; a setting that
# drifts below the next heading silently changes which files it governs.
#
# PROMOTION POLICY: a check runs at error, which blocks a commit, only when
# one of two things is true. Either the fix is mechanical and the check has
# no known false-positive class, so there is nothing to argue about. Or the
# check marks content that must never ship, no matter how much work the fix
# takes. Everything else sits at warning: real enough to show, not certain
# enough to block.
#
# Run: vale FILE       Update the styles: vale sync

StylesPath = @HOME@/Library/Application Support/vale/styles

# suggestion < warning < error. Set to warning, not suggestion, because the
# vale-ls language server pushes everything at or above this level into
# Claude's context on every edit—and a long document generates over a
# thousand suggestions, which would drown the session.
#
# Nothing is lost: `vale --minAlertLevel=suggestion FILE` shows the lot on
# demand, and the pre-commit hook names its own level (error) either way.
MinAlertLevel = warning

# The last three are the hand-written styles (AIWriting, STE, Grammar). They
# live in ~/git/github.com/cptaffe/vale-styles and install from local zips:
# edit there, run `make`, then `vale sync`. Do not edit them under styles/—
# the next sync overwrites them from the zips.
Packages = proselint, write-good, Readability, Google, Microsoft, RedHat, \
           https://github.com/ammil-industries/vale-signs-of-ai-writing/releases/latest/download/signs-of-ai-writing.zip, \
           @REPO@/dist/AIWriting.zip, \
           @REPO@/dist/STE.zip, \
           @REPO@/dist/Grammar.zip

Vocab = Technical

# `.env.example` files carry an `.example` extension, so the dotenv mapping
# misses them; read them as dotenv.
[formats]
example = env

# =============================================================================
# Prose
# =============================================================================
[*.{md,txt,rst}]
BasedOnStyles = Vale, proselint, write-good, Readability, STE, AIWriting, Grammar, signs-of-ai-writing, Google, Microsoft, RedHat

# The GCP product names hide the word "Cloud" from Google.WordList, which
# wants bare "Cloud" written as GCP—right about "our cloud", wrong about a
# proper noun.
TokenIgnores = (Google Cloud|Cloud (?:Run|SQL|Storage|Logging|Build|Functions))

# --- Orwell, made enforceable ---

# Rule 3: if it is possible to cut a word out, always cut it out.
# TooWordy works from a fixed word list and does misfire—it calls
# "validate" and "requirement" wordy—so it advises rather than insists.
write-good.TooWordy = warning
proselint.Very = error

# Annotations catches TODO/FIXME/XXX markers. Demoted: a TODO may ship on
# purpose, tracked rather than fixed on the spot, so blocking a commit on
# one would be wrong.
proselint.Annotations = warning

# Rule 4: never use the passive where you can use the active.
write-good.Passive = warning

# Rule 1: no figure of speech you are used to seeing in print. Demoted:
# fixing a cliché takes judgment about the replacement, not a mechanical
# swap, so it must not block a commit.
write-good.Cliches = warning
proselint.Cliches = warning

# Rule 5: no jargon where an everyday word exists.
proselint.Jargon = warning
# The rule's name is CorporateSpeak; 'Corporate' was a dead key that let it
# run at its packaged error.
proselint.CorporateSpeak = warning

# "There is a X that..." buries the subject. Good advice, but a nudge rather
# than a defect, so it must not block a commit.
write-good.ThereIs = warning

# Hedging reads as padding and usually hides an unmade decision.
write-good.Weasel = warning
write-good.Illusions = error
write-good.So = suggestion

# E-Prime bans the verb "to be" outright. Measured: 395 of 2,222 alerts on
# a 38-file corpus—17% of everything, nearly all on correct sentences.
# Suggestion keeps it out of diagnostics; --minAlertLevel=suggestion shows
# it on request.
write-good.E-Prime = suggestion

# --- inclusive language ---
#
# One implementation, per the dedup policy: RedHat.ConsciousLanguage. Its
# term list (master/slave, whitelist/blacklist, sanity-check) is the
# vocabulary that actually appears in systems docs, and it measured quiet
# on ours—the silent-until-it-matters profile. The alex package is gone
# entirely (2026-08): its armed rules (Gendered, Race, LGBTQ) fired zero
# times across two corpora; its Profanity family measured 13 of 13 false
# (dead, execution, kill, crash, premature); its LGBTQ rule needed a
# carve-out for "bi-temporal". The Gender/GenderBias copies in Google,
# Microsoft, and proselint duplicate the keeper.
RedHat.ConsciousLanguage = warning
Google.Gender = NO
Google.GenderBias = NO
Microsoft.Gender = NO
Microsoft.GenderBias = NO
Microsoft.BiasFree = NO
proselint.GenderBias = NO

# --- noise control ---

# Vale.Spelling flags every technical term. The Technical vocab (accept.txt)
# is the place to add them, not a blanket disable—a spellcheck you switch
# off catches nothing.
Vale.Spelling = warning

# Repetition catches real duplicates ("the the") and is worth keeping loud.
Vale.Repetition = error

# Terms enforces capitalisation of branded names. Suggestion, permanently:
# promotion was measured and failed. The vocabulary mixes cases (agent,
# Markdown, HTTPS), so Terms fights ordinary prose—1,738 corpus hits,
# mostly case-noise on 'Agent', 'https', 'markdown'.
Vale.Terms = suggestion

# '2x2' really should be '2×2'—these are dimensions in prose, not code.
# Error, as promised once the infographic reference docs were fixed; they
# were (27 instances across 6 files, 2026-08).
proselint.Typography = error
proselint.Spelling = NO


# --- the three house style guides -------------------------------------------
#
# Enabled broadly, with the overlaps resolved. Left alone they triple-report
# the same sentence, and two of them contradict each other outright.

# Dashes. The convention: em dashes yes, spaces around them no. An earlier
# version of this file defended spaced em dashes as "a deliberate voice
# choice"—the author of that comment was the model whose tell it is.
# Microsoft.Dashes is the keeper: it catches one-sided spaces where
# Google.EmDash needs both sides. RedHat.EmDash bans the em dash itself,
# which is not the convention.
Microsoft.Dashes = error
Google.EmDash = NO
RedHat.EmDash = NO

# Passive voice: write-good already covers it. Three more copies add nothing.
Google.Passive = NO
Microsoft.Passive = NO
RedHat.PassiveVoice = NO

# Sentence length: STE.SentenceLength caps at 25, which is stricter than
# Microsoft's 30 and RedHat's average of 32. The tightest rule wins.
Microsoft.SentenceLength = NO
RedHat.SentenceLength = NO

# Contractions: Google and Microsoft REQUIRE them, RedHat FORBIDS them. A
# straight contradiction, so pick one. STE prefers full forms, so RedHat wins.
Google.Contractions = NO
Microsoft.Contractions = NO
RedHat.Contractions = suggestion

# Spelling: Vale.Spelling plus the Technical vocab already does this.
RedHat.Spelling = NO

# Acronyms: three rules all asking for a definition on first use. Keep one,
# and only as a suggestion—internal notes can assume API, GKE and CAC.
Microsoft.Acronyms = suggestion
Google.Acronyms = NO
RedHat.Definitions = NO
Microsoft.HeadingAcronyms = suggestion

# Latin abbreviations: Google.Latin and Microsoft.Foreign make the same call
# (i.e. -> that is). Keep one. This is Orwell's rule 5, so it stays an error.
Microsoft.Foreign = NO

# Terminology. This is the part of these guides worth having: substitution
# rules that catch 'e-mail' for 'email' and similar drift.
Microsoft.Terms = warning
Google.WordListCase = warning
RedHat.TermsSuggestions = suggestion

# House style on punctuation and voice—real opinions, worth seeing, never
# worth blocking a commit over.
Google.Semicolons = suggestion
Microsoft.Semicolon = NO
Google.We = suggestion
Microsoft.We = NO
Google.Ellipses = suggestion
Microsoft.Ellipses = NO
RedHat.Hyphens = suggestion
RedHat.Slash = suggestion
# GitLinks enforces Red Hat's policy against linking github.com from product
# docs. Personal READMEs link GitHub constantly and correctly.
RedHat.GitLinks = NO
RedHat.PascalCamelCase = suggestion
Microsoft.Avoid = warning
Microsoft.Vocab = suggestion
Google.Headings = suggestion
Microsoft.Headings = NO
RedHat.Headings = NO


# --- severity: error means "unambiguously wrong", because errors block commits
#
# Kept as an error—Orwell's rule 5, no judgement needed:
#   Google.Latin      e.g. -> for example
#
# LyHyphens is right about 'externally-shareable' and 'silently-dropped', but
# it matches any word ending in -ly, so it also flags 'friendly-name' where the
# hyphen is correct. A rule with a known false-positive class cannot block.
Google.LyHyphens = warning
#
# Demoted—right often enough to show, wrong often enough in technical text
# that blocking a commit would be rude:
Microsoft.Auto = warning
RedHat.TermsErrors = warning
Microsoft.HeadingColons = suggestion
Google.Units = suggestion
Google.Headings = suggestion

# Quoting. Both rules demand American typesetting—punctuation inside the
# quotes. For a quoted literal that is actively wrong: "422s". moves the period
# inside a string that does not contain one. Keep one, as a suggestion.
Google.Quotes = suggestion
Microsoft.Quotes = NO


# --- uncurated defaults, measured and decided (2026-08) ---------------------
#
# 103 package rules never appeared in this file and ran at whatever level
# their authors chose. Measured over a 280-file docs corpus; the offenders
# get keys, the quiet rest keep their defaults.

# Fires on "Label: Sentence" list items, standard in README-style docs
# (803 hits, near-all false).
Google.Colons = NO
# Docs legitimately describe future behavior (411 hits).
Google.Will = NO
# "Use parentheses judiciously"—2,342 hits, the largest single source, and
# not actionable at any volume.
Google.Parens = NO
# Flags "roughly" and friends. Advice, not defect.
Microsoft.Adverbs = suggestion
# Substitution nags with unvetted false-positive character.
RedHat.TermsWarnings = suggestion
RedHat.CaseSensitiveTerms = suggestion
RedHat.Using = suggestion

# Error means "blocks a commit". These two earn it: mechanical and
# false-positive-free by construction.
RedHat.MergeConflictMarkers = error
RedHat.SessionId = error

# The rest of the packaged errors demote to warning—plausible rules whose
# false-positive character nobody has measured, and an unmeasured rule does
# not gate. Duplicates dedupe to one keeper first.
Google.Spacing = warning
Microsoft.Spacing = NO
RedHat.Spacing = NO
Microsoft.AMPM = warning
Google.AMPM = NO
Microsoft.DateFormat = warning
Google.DateFormat = NO
Microsoft.Ordinal = warning
Google.Ordinal = NO
Google.Exclamation = warning
Microsoft.ExclamationPoints = NO
Google.OxfordComma = warning
Microsoft.OxfordComma = NO
RedHat.OxfordComma = NO
Google.HeadingPunctuation = warning
Microsoft.HeadingPunctuation = NO
RedHat.HeadingPunctuation = NO
Microsoft.FirstPerson = warning
Google.FirstPerson = NO
Microsoft.DateNumbers = warning
Microsoft.DateOrder = warning
Microsoft.Negative = warning
Microsoft.Percentages = warning
Microsoft.Plurals = warning
Microsoft.RangeTime = warning
Microsoft.Units = warning
Google.OptionalPlurals = warning
Google.Periods = warning
Google.Slang = warning
RedHat.Abbreviations = warning
proselint.Airlinese = warning
proselint.AnimalLabels = warning
proselint.Apologizing = warning
proselint.Archaisms = warning
proselint.But = warning
proselint.Cursing = warning
proselint.DateCase = warning
proselint.DateMidnight = warning
proselint.DateRedundancy = warning
proselint.DateSpacing = warning
proselint.Diacritical = warning
proselint.Hyperbole = warning
proselint.Malapropisms = warning
proselint.Nonwords = warning
proselint.Oxymorons = warning
proselint.RASSyndrome = warning
proselint.Skunked = warning
proselint.Uncomparables = warning


# --- signs of AI writing -----------------------------------------------------
#
# The published ruleset from ammil-industries, which implements
# Wikipedia:Signs_of_AI_writing. Adopted whole rather than hand-rolled: it has
# 18 rules and test fixtures, and covers artifacts I would not have thought of
# (ChatGPT copy-paste, citation markers, knowledge-cutoff hedges, UTM params).
#
# Raised from its default suggestion to warning: these are the "overused word"
# rules, which is the thing actually worth being told about.
signs-of-ai-writing.Vocabulary = warning
signs-of-ai-writing.Symbolism = warning
signs-of-ai-writing.Narrative = warning

# Left at the package's own levels—its error tier is unambiguous artifacts
# ("As an AI language model", :contentReference markers, unfilled placeholders)
# and those SHOULD block a commit. The rest stay suggestions because, as the
# author says, the patterns appear in ordinary formal writing too.

# Scores the file as a whole, so it fires once rather than per line.
Readability.FleschKincaid = warning
Readability.AutomatedReadability = NO
Readability.ColemanLiau = NO
Readability.GunningFog = NO
Readability.LIX = NO
Readability.SMOG = NO

# =============================================================================
# Source comments
#
# Vale reads the comments out of a source file and ignores the code, so this
# covers the prose engineers write most of. The set is deliberately smaller
# than for documents: a comment is a fragment, not a paragraph, and the full
# prose rules fire constantly on lines like "# returns None if absent".
# =============================================================================
[{*.{py,go,js,jsx,ts,tsx,rs,java,kt,rb,php,c,cpp,h,hpp,cs,scala,swift,lua,pl,sh,bash,yml,yaml,groovy,rego,env,mk,dockerfile},*.env.example,Jenkinsfile,Dockerfile,Containerfile,Makefile,GNUmakefile}]
BasedOnStyles = Vale, AIWriting, Grammar, signs-of-ai-writing

Vale.Repetition = error
Vale.Terms = NO

# Comments are where stale metaphors and dead jargon settle and never get read
# again. These three earn their place; the rest of the prose set does not.
write-good.Cliches = warning
proselint.Cliches = warning
proselint.CorporateSpeak = warning

RedHat.ConsciousLanguage = warning

proselint.Typography = NO
proselint.Spelling = NO

# Spellcheck is off for comments, and that is a measured decision rather than
# laziness: over 105 backend files it produced 555 warnings, and nearly all
# were identifiers the comment is naming—noqa, bool, ask_user, thread_id,
# viewBox. TokenIgnores does not reliably strip them inside comment scopes.
# A comment that names the code around it is doing its job. Prose keeps
# spellcheck on, where the vocabulary approach works.
Vale.Spelling = NO

# Readability scores and sentence length assume paragraphs. A comment is a
# fragment, so these only produce noise here.
Readability.FleschKincaid = NO
Readability.FleschReadingEase = NO
STE.SentenceLength = NO

# Imperative mood for doc comments, PEP 257 style. STE is not in this
# section's BasedOnStyles, but a named rule in a section with a non-empty
# BasedOnStyles runs anyway—the same mechanism that enables
# proselint.Cliches above.
STE.ImperativeOpeners = warning
STE.BuriedInstruction = warning

# Em dashes without spaces, same as prose; warning here because a comment
# dash blocking a commit in a legacy file would be rude.
Microsoft.Dashes = warning

# "gone from the"—error in prose, warning here for the same reason as
# Dashes.
STE.GoneFrom = warning

# Terminology drift matters in comments too; the rest of the house guides are
# written for paragraphs and only produce noise on fragments.
Microsoft.Terms = suggestion
Google.WordListCase = suggestion

# =============================================================================
# Vale rule files
#
# The source-comments glob above now covers yml, which pulls in the rule
# files themselves—and a rule file quotes the phrases it bans, so
# Grammar.ModalOf flags its own swap table and Eggcorns flags its own
# catalog. Rule files are patterns, not prose; exempt them wholesale. The
# glob matches both this repo's styles/ and the deployed StylesPath.
# =============================================================================
[**/styles/**/*.yml]
# The empty list silences the file entirely; measured against the full
# StylesPath, per-rule keys in a section with an empty BasedOnStyles never
# fire, so listing individual NOs here adds nothing. Re-enabling even the
# mild rules (Cliches, Corporate, Terms) is not worth it either: measured
# once, proselint and write-good's own cliché catalogs alone produce ~2,900
# quotation warnings.
BasedOnStyles =

# =============================================================================
# Style READMEs
#
# Rule inventories: tables of rule names and pattern examples. The word-length
# metrics read CamelCase rule names as very long words, so the file-level
# readability scores misfire. Inline vale-off comments cannot silence them—
# metric rules score the whole document—so the carve-out lives here.
# =============================================================================
[**/styles/*/README.md]
Readability.FleschKincaid = NO
Readability.FleschReadingEase = NO

# =============================================================================
# Word lists
#
# Lists of words, one per line—the prose glob above would lint them as
# prose. The sources are words/base.txt (committed) and words/local.txt
# (gitignored, employer-specific); bin/words renders them into the Vale
# vocabulary and the Harper dictionary, and the pre-commit hook re-renders
# on change. Later sections win, so this carve-out must stay last.
# =============================================================================
[{**/accept.txt,**/reject.txt,**/dictionary.txt,**/words/*.txt}]
BasedOnStyles =
